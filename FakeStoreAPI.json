              "});\r",
              "\r",
              "let requestData = pm.request.body.raw;\r",
              "let requestJson = JSON.parse(requestData);\r",
              "let responseJson = pm.response.json(); // Fixed to use pm.response.json()\r",
              "\r",
              "pm.test(\"Validate the Request Data Matches Response Data\", ()=>{\r",
              "    pm.expect(responseJson.title).to.equal(requestJson.title);\r",
              "    pm.expect(responseJson.price).to.equal(requestJson.price);\r",
              "    pm.expect(responseJson.description).to.equal(requestJson.description);\r",
              "    pm.expect(responseJson.category).to.equal(requestJson.category);\r",
              "    pm.expect(responseJson.id).to.be.a('number');\r",
              "}); \r",
